# Keeps the login screen (noctalia-greeter) on Caelestia's wallpaper and colours.
# Off until `greeter-sync enable`, which also turns on passwordless sync.
[Unit]
Description=Watch Caelestia's wallpaper and scheme for the login screen
ConditionPathExists=/usr/bin/noctalia-greeter-apply-appearance

[Path]
PathChanged=%h/.local/state/caelestia/scheme.json
PathChanged=%h/.local/state/caelestia/wallpaper/path.txt
Unit=greeter-sync.service

[Install]
WantedBy=default.target
