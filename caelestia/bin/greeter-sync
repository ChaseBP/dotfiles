#!/usr/bin/env bash
# greeter-sync - put Caelestia's current wallpaper on the login screen (Plasma Login
# Manager). `wall hook` runs it after every wallpaper change, so normally there's
# nothing to do by hand.
#   greeter-sync [image]   sync now (default: the current wallpaper)
# No root needed: the desktop step points the login screen at
# /var/lib/caelestia-greeter/wallpaper.jpg, in a folder this user owns.
set -euo pipefail

DIR=/var/lib/caelestia-greeter
[[ -d $DIR && -w $DIR ]] || exit 0   # login screen not set up for this (run the desktop step)

wall=${1:-$(cat "$HOME/.local/state/caelestia/wallpaper/path.txt" 2>/dev/null || true)}
[[ -f $wall ]] || { echo "greeter-sync: no wallpaper to sync" >&2; exit 1; }

# Skip if this exact file is what the login screen already shows.
stamp="$wall $(stat -c %Y.%s "$wall")"
[[ -f $DIR/wallpaper.jpg && $(cat "$DIR/.source" 2>/dev/null) == "$stamp" ]] && exit 0

# Always JPEG at one fixed path: changing the path in /etc/plasmalogin.conf needs root.
# Written beside the target and renamed over it, so the greeter never reads half a file.
tmp=$(mktemp "$DIR/.wallpaper.XXXXXX")
trap 'rm -f "$tmp"' EXIT
case ${wall,,} in
  *.jpg|*.jpeg) cp "$wall" "$tmp" ;;
  *)            magick "${wall}[0]" -quality 92 "jpg:$tmp" ;;
esac
chmod 644 "$tmp"
mv -f "$tmp" "$DIR/wallpaper.jpg"
trap - EXIT
printf '%s\n' "$stamp" >"$DIR/.source"
