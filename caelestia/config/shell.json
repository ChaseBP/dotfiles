{
    "appearance": {
        "transparency": {
            "enabled": false
        }
    },
    "background": {
        "wallpaperEnabled": true
    },
    "dashboard": {
        "showWeather": false
    },
    "general": {
        "apps": {
            "explorer": [
                "thunar"
            ],
            "terminal": [
                "/usr/bin/ghostty",
                "--gtk-single-instance=true",
                "-e"
            ]
        },
        "idle": {
            "inhibitWhenAudio": true,
            "inhibitWhenCharging": false,
            "lockBeforeSleep": true,
            "timeouts": [
                {
                    "idleAction": ["sh", "-c", "c=$(brightnessctl get); t=$(( c / 3 > 75 ? c / 3 : 75 )); brightnessctl -s set $(( t < c ? t : c ))"],
                    "returnAction": ["brightnessctl", "-r"],
                    "inhibitWhenCharging": true,
                    "timeout": 300
                },
                {
                    "idleAction": "lock",
                    "timeout": 600
                },
                {
                    "idleAction": "dpms off",
                    "returnAction": "dpms on",
                    "inhibitWhenAudio": true,
                    "timeout": 630
                },
                {
                    "idleAction": ["systemctl", "suspend-then-hibernate"],
                    "inhibitWhenCharging": true,
                    "timeout": 900
                }
            ]
        }
    }
}
